SERVICE_NAME=identity
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://tusumba:tusumba@localhost:5432/tusumba
# Пара ключей для разработки: uv run python -m tusumba_common.testing dev-keys
# Закрытый ключ только у Identity (PEM; допустим вид с \n одной строкой), публичный - у всех сервисов.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SERVICE_TOKEN=dev-service-token
